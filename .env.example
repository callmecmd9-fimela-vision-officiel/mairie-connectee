# Modèle SANS secret. Ne jamais committer de valeur réelle.
# Ces variables sont des SECRETS des Edge Functions Supabase
# (Dashboard > Edge Functions > Secrets, ou `supabase secrets set`), pas des variables du navigateur.
# Le front (JS vanilla sans build) n'embarque que l'URL Supabase et la clé anon publique (js/supabase.js).

# Fournies automatiquement par Supabase aux Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# saas-admin / sa-admin
ALLOWED_ORIGIN=https://VOTRE-DOMAINE
SITE_URL=https://VOTRE-DOMAINE

# ia-texte (facultatif)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=

# paiement-webhook (paiement mobile Wave / Orange Money) — secrets des Edge Functions, jamais dans le navigateur
WAVE_WEBHOOK_SECRET=
WAVE_API_KEY=
OM_API_KEY=
WAVE_TIMESTAMP_TOLERANCE_SECONDS=0
