# Modèle SANS secret. Ne jamais committer de valeur réelle.
# Ces variables sont des SECRETS des Edge Functions Supabase
# (Dashboard > Edge Functions > Secrets, ou `supabase secrets set`), pas des variables du navigateur.
# Le front (JS vanilla sans build) n'embarque que l'URL Supabase et la clé anon publique (js/supabase.js).

# Fournies automatiquement par Supabase aux Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# saas-admin / sa-admin
ALLOWED_ORIGIN=https://VOTRE-DOMAINE
SITE_URL=https://VOTRE-DOMAINE

# ia-texte (facultatif)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=

# paiement-webhook (paiement mobile Wave / Orange Money) — secret de l'Edge Function, jamais dans le navigateur.
# Clé maîtresse (16 caractères minimum) qui chiffre / déchiffre les clés API de chaque commune
# (table parametres_paiement_communes). Les clés des communes ne sont PAS des variables d'environnement.
PAIEMENT_ENC_KEY=
WAVE_TIMESTAMP_TOLERANCE_SECONDS=0
